{
  "name": "vigocan-manifest",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "assets": {
    "directory": "./src"
  },
  "routes": [
	{
		"pattern": "vigocan.com",
		"custom_domain": true
	}
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
